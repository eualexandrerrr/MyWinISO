# O Git no Windows converte LF em CRLF no checkout; bash e wsl.conf não aceitam CRLF.
*.sh      text eol=lf
wsl.conf  text eol=lf
*.ps1     text eol=crlf
*.xml     text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.jpg     binary
*.exe     binary
*.dll     binary
# tema do Ventoy: o GRUB le o theme.txt com LF; fontes e imagens sao binarias
ventoy/theme/**/theme.txt  text eol=lf
*.pf2     binary
*.png     binary
