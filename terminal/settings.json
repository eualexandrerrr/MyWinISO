                "face": "FiraCode Nerd Font",
                "size": 10
            },
            "historySize": 100000,
            "opacity": 100,
            "padding": "14, 10",
            "scrollbarState": "hidden",
            "startingDirectory": "%USERPROFILE%",
            "useAcrylic": false
        },
